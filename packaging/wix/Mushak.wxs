<?xml version="1.0" encoding="windows-1252"?>
<!--
  MSI installer for Mushak, built with the WiX v3 toolset (candle + light).

  Per-machine install: a UAC prompt protects the binaries under Program Files.
  That protected location, plus Authenticode signing and the helper's embedded
  manifest, is required before Windows grants UIAccess to the wheel helper.

  Version is passed at build time: `candle -dVersion=0.0.1 ...`.
  Use build-installer.ps1 so both executables are signed before packaging.
  The UpgradeCode below is PERMANENT - never change it, or upgrades break.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Mushak"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Divyang Chauhan"
           UpgradeCode="1F67CEE8-F3FF-4EB7-811C-C90D40B1B354">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Mushak $(var.Version) installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Mushak is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs metadata. The icon is pulled from the exe's own
         embedded resource, so there's a single icon source of truth. -->
    <Icon Id="MushakIcon" SourceFile="target\release\mushak.exe" />
    <Property Id="ARPPRODUCTICON" Value="MushakIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/divyangchauhan/Mushak" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Mushak" />
      </Directory>
      <Directory Id="CommonProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Keep both signed binaries in one administrator-protected component.
           The helper has no shortcut and cannot be meaningfully launched on
           its own; Mushak gives it only a private inherited pipe. -->
      <Component Id="MainBinaries" Guid="58151D65-D47D-4D4B-8CFE-B516E2522EC8" Win64="yes">
        <File Id="MushakExe" Source="target\release\mushak.exe" KeyPath="yes" />
        <File Id="MushakUiAccessHelper" Source="target\release\mushak-uiaccess-helper.exe" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="CommonProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="MushakStartMenu"
                  Name="Mushak"
                  Description="Lightweight replacement for Logitech Options+"
                  Target="[INSTALLFOLDER]mushak.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MushakIcon" />
        <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\Mushak" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Mushak" Level="1">
      <ComponentRef Id="MainBinaries" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Wizard: welcome -> license -> install dir -> progress -> finish.
         WixUI_InstallDir puts the license and install-dir screens on the top
         banner (not the full side panel), so overlaid heading text never hits
         the branding. Welcome/Finish still show the branded side panel. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\wix\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="packaging\wix\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="packaging\wix\banner.bmp" />
  </Product>
</Wix>
